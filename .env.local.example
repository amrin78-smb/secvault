# Server
SERVER_IP=
APP_PORT=3010

# Database
DATABASE_URL=postgresql://secvault_user:PASSWORD@SERVER_IP:5432/secvault

# PostgreSQL superuser ('postgres') password -- NOT read by the app itself
# (which only ever connects as secvault_user via DATABASE_URL above). Set
# automatically by Install-SecVault.ps1, which generates it fresh every
# install and never hardcodes or prompts for it. Kept here purely for
# manual DB administration (e.g. running psql -U postgres by hand).
PG_ADMIN_PASSWORD=

# Auth (standalone — not shared with NocVault suite)
NEXTAUTH_URL=http://SERVER_IP:3010
NEXTAUTH_SECRET=

# Credentials encryption (SEPARATE from NEXTAUTH_SECRET)
CREDENTIAL_KEY=

# LDAP/AD (optional — leave blank for local admin only)
LDAP_URL=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=

# SMC
ALLOW_SELF_SIGNED_SSL=true

# Feeds
FEED_POLL_INTERVAL_HOURS=6
CONFIG_PULL_INTERVAL_HOURS=24
NVD_API_KEY=

# VPN active-session polling (minutes, 5-59) -- only devices whose adapter
# implements the optional getVpnSessionSummary() capability are polled
# (Fortinet only, as of 2026-07-19). See lib/schema.sql's
# vpn_session_snapshots comment.
VPN_POLL_INTERVAL_MINUTES=30

# SNMP metric polling (minutes, 5-59) -- only devices with snmp_enabled=true
# whose adapter implements the optional getSnmpMetrics() capability are
# polled (Cisco ASA, Fortinet, Palo Alto, Forcepoint, Sangfor as of
# 2026-07-21). See lib/schema.sql's snmp_metric_snapshots comment and
# CLAUDE.md's "SNMP Monitoring" section.
# NOTE (v2.50.0): this interval now also paces getPerformanceMetrics(), which
# reads CPU/memory/session counts over the device's EXISTING management
# transport (SSH/REST) and needs no SNMP credential and no snmp_enabled
# opt-in -- so the job runs against every active device, not only SNMP ones.
# Because it opens real management sessions it is mutually exclusive with the
# VPN poll and the rule-version pull; whichever starts first wins and the
# others skip that tick. Avoid setting this to a divisor of
# VPN_POLL_INTERVAL_MINUTES or the two will collide every cycle.
SNMP_POLL_INTERVAL_MINUTES=15

# Retention (days) for vpn_session_snapshots + snmp_metric_snapshots -- daily
# [snapshot-retention] job in services/engine-worker.js.
SNMP_VPN_RETENTION_DAYS=180

# Retention (days) for device_configs -- daily [config-retention] job in
# services/engine-worker.js (lib/engines/configRetention.js). This is the
# single largest table in the database by a wide margin (measured 2026-08-25:
# 447 MB of a 529 MB database, ~9.5 MB/day, ~3.4 GB/year) because one full
# config snapshot is stored per device per pull whether or not anything
# changed. 60d bounds it at roughly 60 x the fleet's daily config volume.
# Lower it (e.g. 30) to reclaim space sooner.
# ⛔ These are NEVER deleted at any age: the device's baseline snapshot
# (is_baseline), the newest row per device, and the 10 most recent rows per
# device (MIN_KEEP_CONFIGS -- a safety floor constant in configRetention.js,
# deliberately not an env var). The change record itself lives in config_diffs,
# which this job never touches.
CONFIG_RETENTION_DAYS=60

# Retention (days) for config_backups -- same daily job, deliberately a much
# longer window than CONFIG_RETENTION_DAYS above: a config_backups row is only
# written when a diff was actually detected, so each one is a distinct moment
# of real change and the whole table is ~1.5% of device_configs' size. Only
# label='auto' rows are ever deleted; 'manual'/'pre-change' (operator-created)
# backups are kept forever.
CONFIG_BACKUP_RETENTION_DAYS=365

# Outbound alerting poll (minutes, 5-59) -- checks for new patch_now CVEs /
# critical compliance failures / unacknowledged config diffs and dispatches
# to every enabled notification_channels row. See lib/schema.sql's
# notification_channels/notification_dispatch_log comments and
# lib/engines/notificationDispatch.js.
NOTIFICATIONS_POLL_INTERVAL_MINUTES=15

# Log retention
LOG_RETENTION_HOT_DAYS=90
LOG_RETENTION_WARM_DAYS=365

# Suite integration (optional — leave blank for standalone)
NETVAULT_URL=

# Syslog ingestion (Phase 8 - SecVault-Collector)
# Ports: 514 is the standard. They are configurable so the collector can be
# exercised on 1514 first without disturbing whatever holds 514.
SYSLOG_UDP_PORT=514,1514
SYSLOG_TCP_PORT=514,1514
# How often the in-memory buffer is spooled to disk and inserted (ms).
SYSLOG_FLUSH_MS=2000
# Datagrams held in memory between flushes. On overflow the collector COUNTS
# and REPORTS the drops (syslog_ingest_stats.dropped) rather than pretending it
# kept up - silent loss under load looks identical to a quiet network.
SYSLOG_MAX_BUFFER=200000
# Raw event retention in DAYS. Enforced by DROPPING daily partitions, never by
# DELETE. The two PERMANENT rollups (hourly traffic, hourly per-rule hits) are
# kept indefinitely -- they are small and bounded by the size of the fleet.
# Sized from measurements on this fleet (2026-09-08): ~86M rows/day, and 367
# bytes/row once the raw line is dropped for ordinary allowed traffic -- about
# 37 GB/day, so 30 days is ~1.1 TB. It was 7 while every row carried its
# 755-byte raw line (1,122 bytes/row, ~96 GB/day).
SYSLOG_RETENTION_DAYS=30

# How much of the raw line the DATABASE keeps: all | security | none.
# The compressed archive keeps EVERY line regardless; this only decides what
# stays searchable in SQL.
# "security" (the default) keeps the raw line for anything UNPARSED,
# NON-TRAFFIC or DENIED -- measured at 8.3% of the stream, and exactly the
# events an investigation opens. It is dropped only for the 91.7% that is
# routine allowed traffic, whose every field already has its own column.
# Do NOT set this to none with the archive disabled: a line nothing could
# parse would then exist nowhere at all. The collector warns if you do.
SYSLOG_RAW_MESSAGE=security
# The three DETAIL rollups (per-host, per-application, blocked-destination)
# are keyed on HIGH-CARDINALITY values -- measured over ten minutes on this
# fleet: 5,717 distinct source hosts, 986 applications -- so unlike the
# permanent two they are bounded by time and DELETEd, not dropped.
# NOTE: currently the SAME as SYSLOG_RETENTION_DAYS (30), which means the
# rollups presently outlive the raw events by nothing at all. The intent is
# for this to be LONGER -- the point of a rollup is to
# still answer "who was the top talker last month" after the raw events are
# gone. Widgets asking for a longer window than this simply have less data
# behind them; that is not an error.
SYSLOG_DETAIL_RETENTION_DAYS=30
# Compressed raw-log archive -- the storage model Firewall Analyzer used, and
# the reason it held a year in ~1 TB while a row-per-event database needs that
# for a week. Measured on FWA own preserved archives: 315.8 GB on disk holding
# 4,186 GB of raw text (13.3x). Measured on this live stream: 10.8x.
#
# PostgreSQL cannot do this. TOAST only compresses once a tuple exceeds ~2 KB
# and these rows are ~1 KB, so message is stored VERBATIM -- 748 bytes avg,
# 752 bytes on disk. And even compressed per row it would only reach 2-3x,
# because the 10.8x comes from compressing ACROSS lines. That is architectural.
#
# Each flush appends one complete gzip member, so the day file stays readable
# with gunzip/zcat/zgrep and a crash can damage at most the final member.
SYSLOG_ARCHIVE_ENABLED=true
# Blank = <install dir>\archive. NOTE: this comment is on its own line on
# purpose — an inline "# ..." after the value was being read AS the value.
SYSLOG_ARCHIVE_DIR=
# 60 days ~= 500 GB at the measured rate. 90 ~= 750 GB.
SYSLOG_ARCHIVE_RETENTION_DAYS=60
# Durable spool. Written and fsync'd BEFORE the DB insert, deleted only after
# it succeeds, and replayed on startup.
# Leave BLANK to use <install dir>\spool. Install-SecVault.ps1 sets this
# explicitly from its -SpoolDir parameter and creates the directory.
# Point it at a data volume if you have one -- at ~1,400 events/sec the spool
# is small but constantly rewritten, so keep it off the OS disk if you can.
SYSLOG_SPOOL_DIR=
# Rollup maintenance. TIERED, unlike LogVault's single 24h-every-5-min window:
# at ~1,400 events/sec that design would re-aggregate ~93M rows 288 times a day.
#   RECENT sweep runs every SYSLOG_ROLLUP_INTERVAL_MINUTES over the trailing
#   SYSLOG_ROLLUP_RECENT_HOURS; a WIDE sweep runs hourly over the trailing
#   SYSLOG_ROLLUP_LOOKBACK_HOURS.
# The WIDE sweep is what catches events that arrived LATE (DB outage, ingest
# backpressure, or the collector being down during a deploy). Without it those
# buckets are never revisited and the rollup silently under-counts forever.
# Do not shrink it "to save cycles".
# The RECENT pass keeps the newest buckets fresh for the dashboards. Note
# sweepWindow() adds an hour, so 1 here is a 2-hour pass. It was 3 (a 4-hour
# pass) and took 233-262s against the 300s cycle below -- about to overrun.
# Narrowing THIS loses nothing: every hour is still rebuilt by the sliced wide
# sweep. Narrowing the LOOKBACK below would lose late events permanently.
SYSLOG_ROLLUP_RECENT_HOURS=1
SYSLOG_ROLLUP_LOOKBACK_HOURS=24
SYSLOG_ROLLUP_INTERVAL_MINUTES=5

# How far back the [log-hit] job looks for traffic reaching a curated
# port_exposed port. Deliberately SHORTER than SYSLOG_RETENTION_DAYS: the
# question is "is this service being reached NOW", and a 30-day window would
# keep a CVE in patch_now for a month after the exposure was closed.
LOG_HIT_LOOKBACK_DAYS=7
