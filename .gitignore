# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# env
.env.local
.env*.local

# logs
*.log
npm-debug.log*
# ⛔ ROOT-ANCHORED, and it must stay that way. An unanchored `logs/` matches a
# directory called "logs" at ANY depth, and on 2026-09-08 it silently excluded
# app/(dashboard)/logs/, app/api/logs/ and components/logs/ — the entire Log
# Search feature. It was committed, pushed and "deployed" without ever reaching
# the server, and the build PASSED because the page was missing too, so nothing
# imported the missing components. Verifying over HTTP did not catch it either:
# an unauthenticated /logs returns 307 from middleware whether or not the route
# exists. Only `git check-ignore` and looking for the file on disk found it.
/logs/

# editor
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# misc
.claude-web-files/
.claude-web-images/

# bundled installer prerequisites (large binaries, not source -- see
# installer/dependencies/README.txt for what belongs here)
installer/dependencies/*
!installer/dependencies/README.txt

# One-shot patch/probe scripts written at the repo root during maintenance.
# They must never be committed — they are scratch, and some carry credentials.
/patch-*.js
/backfill-*.js
/bump.js
/audit*.js
/probe-*.js

# ⛔ TLS material (v2.112.0). certs/secvault.key is the server's private key —
# committing it would publish the credential that protects every session, in a
# repository, permanently, for every installation that ever pulls this branch.
# The installer mints these per machine; they are never portable and never
# belong in git. The .bak.* files are the timestamped backups the Settings ->
# Certificate page writes before replacing a pair.
certs/

# ⛔ lib/envFile.js writes a timestamped backup beside .env.local before every
# edit, and that backup holds CREDENTIAL_KEY, the database password and
# NEXTAUTH_SECRET. The existing `.env*.local` rule does NOT cover it, because
# the name ends `.bak` — so one `git add -A` on the server would commit every
# secret in the product to the repository.
.env.local.*.bak
*.env.local.bak
