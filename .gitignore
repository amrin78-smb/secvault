# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# env
.env.local
.env*.local

# logs
*.log
npm-debug.log*
# ⛔ ROOT-ANCHORED, and it must stay that way. An unanchored `logs/` matches a
# directory called "logs" at ANY depth, and on 2026-09-08 it silently excluded
# app/(dashboard)/logs/, app/api/logs/ and components/logs/ — the entire Log
# Search feature. It was committed, pushed and "deployed" without ever reaching
# the server, and the build PASSED because the page was missing too, so nothing
# imported the missing components. Verifying over HTTP did not catch it either:
# an unauthenticated /logs returns 307 from middleware whether or not the route
# exists. Only `git check-ignore` and looking for the file on disk found it.
/logs/

# editor
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# misc
.claude-web-files/
.claude-web-images/

# bundled installer prerequisites (large binaries, not source -- see
# installer/dependencies/README.txt for what belongs here)
installer/dependencies/*
!installer/dependencies/README.txt

# One-shot patch/probe scripts written at the repo root during maintenance.
# They must never be committed — they are scratch, and some carry credentials.
/patch-*.js
/backfill-*.js
/bump.js
/audit*.js
/probe-*.js

# ⛔ TLS material (v2.112.0). certs/secvault.key is the server's private key —
# committing it would publish the credential that protects every session, in a
# repository, permanently, for every installation that ever pulls this branch.
# The installer mints these per machine; they are never portable and never
# belong in git. The .bak.* files are the timestamped backups the Settings ->
# Certificate page writes before replacing a pair.
certs/

# ⛔ lib/envFile.js writes a timestamped backup beside .env.local before every
# edit, and that backup holds CREDENTIAL_KEY, the database password and
# NEXTAUTH_SECRET. The existing `.env*.local` rule does NOT cover it, because
# the name ends `.bak` — so one `git add -A` on the server would commit every
# secret in the product to the repository.
.env.local.*.bak
*.env.local.bak
# ⛔ AND THE RULE ABOVE ONLY CATCHES NAMES THAT *END* IN .bak, WHICH THE REAL
# FILES DO NOT. Found on the production server 2026-10-19, all untracked and
# all visible to `git add -A`:
#   .env.local.bak-20260912-230247   .env.local.bak-rollup
#   .env.local.bak-20260914-141934   .env.local.repaired
#   .env.local.bak-20260918-104802   .env.local.CORRUPT-20260924-123416
#   .env.local.bak-20260921-230240
# Every one holds CREDENTIAL_KEY, the database password and NEXTAUTH_SECRET --
# the .CORRUPT one is the wreckage of the 2026-09-24 encoding incident, kept
# deliberately. The note above this block already warned that "one `git add -A`
# on the server would commit every secret in the product to the repository";
# the pattern written to prevent it did not match the names actually produced.
# A guard that cannot fire, on the file that holds every secret.
.env.local.*
# ...except the one that is MEANT to be committed and carries no values.
!.env.local.example

# Built installer packages (Build-SecVaultPackage.ps1). Large binaries, not source.
dist/

# ⛔ Local development credentials. The REAL file lives in $HOME
# (~/.secvault-local-secrets.json, mode 0600) precisely so git cannot address
# it at all -- `git check-ignore` on it answers "outside repository", which is
# a stronger guarantee than any rule in this file. These patterns exist only to
# catch a COPY somebody drops in the tree "just for a minute": scripts/devdb.sh
# refuses such a copy outright, and this is the second expression of that same
# refusal. See docs/DEV-CREDENTIALS.md.
*local-secrets*
.pgpass
*.pgpass

# Python bytecode from the dev helper scripts (scripts/devwinrm.py).
__pycache__/
*.pyc
